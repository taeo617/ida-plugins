<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>bambu</AssemblyName>
    <RootNamespace>IDA.Bambu</RootNamespace>
    <TargetExt>.rhp</TargetExt>
    <Version>1.0.0</Version>
    <Title>bambu</Title>
    <Description>선택한 객체를 뱀부랩 X2D에 맞게 서포트가 적은 방향으로 눕히고, 크면 나누고, 판별로 배치해 STL로 내보내기</Description>
    <Company>found/Founded</Company>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Rhino 8.0 SDK 기준 → Rhino 8 아무 버전에서나 설치됨 -->
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
